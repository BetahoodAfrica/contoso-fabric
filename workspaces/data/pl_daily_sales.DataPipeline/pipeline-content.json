                  "sqlReaderQuery": {
                    "value": "@if(equals(item().load, 'incremental'),\n    concat('SELECT ', item().columns, ' FROM [', item().schema, '].[', item().table, '] WHERE ModifiedDate >= DATEADD(day, -7, ''', variables('watermark'), ''')'),\n    concat('SELECT ', item().columns, ' FROM [', item().schema, '].[', item().table, ']'))",
                    "type": "Expression"
                  },
                  "partitionOption": "None",
                  "queryTimeout": "02:00:00",
