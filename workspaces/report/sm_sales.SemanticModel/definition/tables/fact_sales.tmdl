	measure 'Order Quantity' = SUM ( fact_sales[order_qty] )
		formatString: 0
		displayFolder: Sales
		lineageTag: 9ac68a9e-45c8-4a35-bd54-a0199370efa6

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Avg Unit Price' = DIVIDE ( SUMX ( fact_sales, fact_sales[unit_price] * fact_sales[order_qty] ), [Order Quantity] )
		formatString: "£"#,0.###############;-"£"#,0.###############;"£"#,0.###############
		displayFolder: Sales
		lineageTag: 75137d9a-421e-45a8-be0a-ec874ad9da8d

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Avg Discount %' =
			DIVIDE ( SUMX ( fact_sales, fact_sales[unit_price] * fact_sales[unit_price_discount] * fact_sales[order_qty] ),
			                             SUMX ( fact_sales, fact_sales[unit_price] * fact_sales[order_qty] ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Sales
		lineageTag: 2d1ec9cd-680c-4cdd-acd8-952f1416fbb5

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

