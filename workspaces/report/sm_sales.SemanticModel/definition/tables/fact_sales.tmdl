table fact_sales
	lineageTag: b06480b1-0cbf-4d61-887c-27501efa2471
	sourceLineageTag: [dbo].[fact_sales]

	measure 'Sales Amount' = SUM(fact_sales[sales_amount])
		displayFolder: Sales
		lineageTag: fa330abc-221e-45dc-a021-36883bbff06e

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Cost' = SUM(fact_sales[total_product_cost])
		displayFolder: Cost & Margin
		lineageTag: e4ffa0ec-da83-47f8-ae56-7b102a5193cc

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin' = fact_sales[Sales Amount]-fact_sales[Total Cost]
		displayFolder: Cost & Margin
		lineageTag: 31930597-2596-4f7d-bc8a-979939b86da6

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin %' = ```
			DIVIDE(fact_sales[Gross Margin], fact_sales[Sales Amount]) 
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Cost & Margin
		lineageTag: 5f7844a0-292b-4f93-be26-117a431fc0b6

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Order Count' = DISTINCTCOUNT(fact_sales[sales_order_number])
		formatString: 0
		displayFolder: Sales
		lineageTag: 34387d05-3a0b-435e-8376-846460066d24

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Sales LY' = ```
			CALCULATE(fact_sales[Sales Amount], SAMEPERIODLASTYEAR(dim_date[date])) 
			```
		displayFolder: Time Intelligence
		lineageTag: e5ed2a60-5cad-4476-91e0-1dab44baf3ee

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales YoY %' = ```
			DIVIDE(fact_sales[Sales Amount] - fact_sales[Sales LY], fact_sales[Sales LY]) 
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 129ca6c8-fbba-4c13-9723-db7e8116533c

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Sales YTD' = ```
			TOTALYTD(fact_sales[Sales Amount], dim_date[date]) 
			```
		displayFolder: Time Intelligence
		lineageTag: c15e2bdf-8c87-41a6-abd6-12630c67aeeb

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tax Amount' = SUM ( fact_sales[tax_amount] )
